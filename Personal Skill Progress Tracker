import csv
import os

FILENAME = "skills.csv"
FIELDNAMES = ["Skill Name", "Proficiency", "Practice Hours", "Milestones Done", "Total Milestones"]


def create_file_if_not_exists():
    if not os.path.exists(FILENAME):
        with open(FILENAME, mode="w", newline="") as f:
            writer = csv.DictWriter(f, fieldnames=FIELDNAMES)
            writer.writeheader()


def load_skills():
    skills = []
    with open(FILENAME, mode="r", newline="") as f:
        reader = csv.DictReader(f)
        for row in reader:
            skills.append(row)
    return skills


def save_skills(skills):
    with open(FILENAME, mode="w", newline="") as f:
        writer = csv.DictWriter(f, fieldnames=FIELDNAMES)
        writer.writeheader()
        writer.writerows(skills)


def add_skill():
    skills = load_skills()

    name = input("Enter skill name (eg. Python, DBMS, DSA): ").strip()

    # check if skill already exists
    for s in skills:
        if s["Skill Name"].lower() == name.lower():
            print("This skill already exists! Use update option instead.")
            return

    proficiency = input("Enter proficiency (Beginner/Intermediate/Advanced): ").strip()
    total_milestones = input("Enter total number of learning milestones for this skill: ").strip()

    new_skill = {
        "Skill Name": name,
        "Proficiency": proficiency,
        "Practice Hours": "0",
        "Milestones Done": "0",
        "Total Milestones": total_milestones
    }

    skills.append(new_skill)
    save_skills(skills)
    print(f"Skill '{name}' added successfully!")


def find_skill(skills, name):
    for s in skills:
        if s["Skill Name"].lower() == name.lower():
            return s
    return None


def update_proficiency():
    skills = load_skills()
    name = input("Enter skill name to update: ").strip()
    skill = find_skill(skills, name)

    if skill is None:
        print("Skill not found!")
        return

    new_prof = input("Enter new proficiency (Beginner/Intermediate/Advanced): ").strip()
    skill["Proficiency"] = new_prof
    save_skills(skills)
    print(f"Proficiency for '{name}' updated to {new_prof}.")


def add_practice_hours():
    skills = load_skills()
    name = input("Enter skill name: ").strip()
    skill = find_skill(skills, name)

    if skill is None:
        print("Skill not found!")
        return

    try:
        hours = float(input("Enter hours practiced today: "))
    except ValueError:
        print("Please enter a valid number.")
        return

    current_hours = float(skill["Practice Hours"])
    skill["Practice Hours"] = str(current_hours + hours)
    save_skills(skills)
    print(f"Added {hours} hours to '{name}'. Total hours: {skill['Practice Hours']}")


def update_milestones():
    skills = load_skills()
    name = input("Enter skill name: ").strip()
    skill = find_skill(skills, name)

    if skill is None:
        print("Skill not found!")
        return

    done = int(skill["Milestones Done"])
    total = int(skill["Total Milestones"])

    if done >= total:
        print("All milestones already completed for this skill!")
        return

    skill["Milestones Done"] = str(done + 1)
    save_skills(skills)
    print(f"Milestone marked complete for '{name}'. Progress: {done+1}/{total}")


def view_summary():
    skills = load_skills()

    if not skills:
        print("No skills added yet.")
        return

    print("\n----- SKILL PROGRESS SUMMARY -----")
    print(f"{'Skill':<15}{'Proficiency':<15}{'Hours':<10}{'Milestones':<12}{'% Complete'}")
    print("-" * 65)

    for s in skills:
        done = int(s["Milestones Done"])
        total = int(s["Total Milestones"])
        percent = (done / total * 100) if total > 0 else 0

        print(f"{s['Skill Name']:<15}{s['Proficiency']:<15}{s['Practice Hours']:<10}"
              f"{f'{done}/{total}':<12}{percent:.1f}%")

    print("-" * 65)


def main_menu():
    create_file_if_not_exists()

    while True:
        print("\n===== PERSONAL SKILL PROGRESS TRACKER =====")
        print("1. Add new skill")
        print("2. Update proficiency")
        print("3. Add practice hours")
        print("4. Mark a milestone as complete")
        print("5. View progress summary")
        print("6. Exit")

        choice = input("Enter your choice (1-6): ").strip()

        if choice == "1":
            add_skill()
        elif choice == "2":
            update_proficiency()
        elif choice == "3":
            add_practice_hours()
        elif choice == "4":
            update_milestones()
        elif choice == "5":
            view_summary()
        elif choice == "6":
            print("Exiting... Keep learning!")
            break
        else:
            print("Invalid choice, please try again.")


if _name_ == "_main_":
    main_menu()
